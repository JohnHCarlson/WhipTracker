# Settings for the Whip Tracker server, read by its service. Installed as
# /etc/whip-tracker.env (mode 640, root:whip-tracker), because ACCOUNTS_KEY is
# a secret. install-app.sh fills it in from `accounts app-key whip-tracker`.
NODE_ENV=production
WHIP_PORT=3102
WHIP_DATA=/var/lib/whip-tracker
ACCOUNTS_URL=http://127.0.0.1:3100
ACCOUNTS_KEY=
